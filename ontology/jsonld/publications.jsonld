    {
      "@id": "https://mos2es.com/ontology/0.1/publication/experimental_record",
      "@type": "Dataset",
      "name": "Experimental Record for A Conservation Law for Commitment (EXP-001 to EXP-007)",
      "author": {
        "@id": "https://mos2es.com/ontology/0.1/entity/deric_j_mchenry"
      },
      "sameAs": "https://doi.org/10.5281/zenodo.19105225",
      "url": "https://doi.org/10.5281/zenodo.19105225",
      "datePublished": "2026-03-19",
      "version": "1.0.0",
      "license": "CC-BY-4.0",
      "abstract": "Seven controlled harness experiments across a 20-signal canonical corpus plus targeted adversarial and structural probes. All runs: GPT-4o-mini, 10 recursive iterations, NLI bidirectional entail + Jaccard surface stability. Key results: Commitment Stability 0.94 ± 0.03 (enforced) vs 0.42 ± 0.12 (baseline); Identity Preservation 92% (enforced) vs 38% (baseline); Drift Rate 0.006/iteration (enforced) vs 0.058/iteration (baseline).",
      "keywords": [
        "Experimental validation",
        "controlled experiments",
        "NLI",
        "Jaccard similarity",
        "recursive transformation",
        "adversarial testing"
      ],

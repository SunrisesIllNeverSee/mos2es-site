      "@id": "https://mos2es.com/ontology/0.1/publication/conservation_law_v05",
      "@type": "ScholarlyArticle",
      "name": "A Conservation Law for Commitment in Language Under Transformative Compression and Recursive Application",
      "author": {
        "@id": "https://mos2es.com/ontology/0.1/entity/deric_j_mchenry"
      },
      "sameAs": "https://doi.org/10.5281/zenodo.20029607",
